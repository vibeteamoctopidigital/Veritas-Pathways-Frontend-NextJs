# Base URL of the Veritas Pathways API, including the /api/v1 prefix.
# Local development:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Production (set this in the Vercel project settings, not in a committed file):
#   NEXT_PUBLIC_API_BASE_URL=https://veritas-pathway-backend-bay.vercel.app/api/v1
#
# Next.js inlines NEXT_PUBLIC_* values into the client bundle at build time, so treat them
# as public. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
